# Rust
/target
**/*.rs.bk

# Node / frontend
node_modules/
ui/dist/
ui/node_modules/

# Tauri build output
src-tauri/target/
src-tauri/gen/

# Models (downloaded separately — multi-GB, not committed)
*.gguf
*.bin

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit. API keys live in the OS keychain, never in files.
.env
.env.*
*.pem

# iOS build products.
# The Xcode project is GENERATED from ios/project.yml by XcodeGen — edit that, run
# `xcodegen generate`, and never commit the .xcodeproj: a hand-merged .pbxproj is how
# a project starts failing to parse.
ios/WhimprFlow.xcodeproj/
# Built by scripts/build-ios-core.sh from whimpr-ffi on every Xcode build.
ios/Frameworks/
ios/DerivedData/
