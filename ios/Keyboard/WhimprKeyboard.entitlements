<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the container app's group exactly, or the handoff silently reads
	     an empty container rather than failing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.whimpr.whimprflow</string>
	</array>
</dict>
</plist>
