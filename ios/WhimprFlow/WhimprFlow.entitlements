<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only channel between the app and the keyboard. Both targets must declare
	     the identical group, and the keyboard only reaches it once the user has
	     turned on Allow Full Access. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.whimpr.whimprflow</string>
	</array>
</dict>
</plist>
